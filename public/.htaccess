<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Let/Let's Encrypt ACME HTTP-01 validation (used by Infomaniak's
    # automatic SSL issuance) must always reach the plain static file
    # under this path, never fall through to index.php — placed first,
    # with [L], so it's unaffected by any rewrite rule added below it,
    # present or future.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Vite build output (build/assets/*) is content-hashed — a new deploy
# always produces new filenames instead of overwriting these in place, so
# caching them for a year is safe. Photo conversions (jpg/jpeg/png/webp/gif)
# come from spatie/laravel-medialibrary, whose URLs are keyed by media ID —
# the same URL never changes content, so 30 days is safe too. Icons/SVGs
# (favicons, logo) aren't ID-keyed and can be swapped in place by a
# redeploy without a filename change, so they keep a shorter lifetime.
# This is the real production path (Infomaniak shared hosting is Apache,
# not the docker/nginx/default.conf used in dev — see DEPLOY.md).
<IfModule mod_expires.c>
    ExpiresActive On

    <FilesMatch "^build/.*\.(?:js|css|woff2?)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>

    <FilesMatch "\.(?:jpg|jpeg|png|webp|gif)$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>

    <FilesMatch "\.(?:svg|ico)$">
        ExpiresDefault "access plus 1 week"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^build/.*\.(?:js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(?:jpg|jpeg|png|webp|gif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(?:svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
