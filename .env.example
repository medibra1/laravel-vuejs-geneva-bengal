# In production: APP_ENV=production, APP_DEBUG=false (never true — it
# leaks stack traces/env values to visitors), APP_URL the real site
# domain (http/https and host must match reality — it drives every
# generated asset/media/route URL, see DEPLOY.md #5).
APP_NAME="Geneva Bengal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_CH

SUPER_ADMIN_EMAIL=super-admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Stripe test-mode keys (never live keys in this file). See `stripe listen`
# in the Stripe CLI to get a local STRIPE_WEBHOOK_SECRET.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Inertia SSR (see DEPLOY.md #2 for how the ssr.js process is kept alive
# in production — not wired to anything here in local dev besides Docker).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Guards GET /cron/run-schedule (see DEPLOY.md #4) — the URL Infomaniak's
# shared-hosting task scheduler hits in place of a real `schedule:run`
# cron entry. Generate a random value for prod, e.g. `openssl rand -hex 32`.
CRON_SECRET=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Bare host, no scheme/port, e.g. genevabengals.ch — see DEPLOY.md #5.
SESSION_DOMAIN=null
# In production (served over HTTPS): SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
